# Parking AI Pro - Environment variables
# IMPORTANT: Do NOT commit this file to GitHub.

APP_NAME=Parking AI Pro
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY

# Render PostgreSQL
# Replace this with the Internal Database URL from your Render PostgreSQL service.
# Example format:
# postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# DeepSeek AI (optional)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
